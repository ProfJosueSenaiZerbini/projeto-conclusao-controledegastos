DATABASE_URL=""
JWT_SECRET=""

# Endereço do site, usado nos links enviados por e-mail.
APP_URL="http://localhost:3000"

# Servidor de e-mail (SMTP). Sem estes campos, nenhum e-mail é enviado:
# o conteúdo aparece só no terminal onde o servidor está rodando.
#
# Para Gmail:
#   1. Ative a verificação em duas etapas na conta Google.
#   2. Crie uma "senha de app" em myaccount.google.com > Segurança.
#   3. Use essa senha de 16 letras em SMTP_PASS (não a senha normal da conta).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_REMETENTE="Verdanz <seu-email@gmail.com>"

# Banco simulado (opcional). Sem estes campos, valem os padrões:
# o banco roda no próprio servidor, em http://localhost:PORT/banco-simulado.
# BANCO_SIMULADO_URL="http://localhost:3000/banco-simulado"
# BANCO_SIMULADO_SECRET="um-segredo-diferente-do-JWT_SECRET"
